{
  "$description": "Tallyo design tokens. Palette 'Laguna' (dark, default) with light theme derived from 'Nebbia'. Font: Manrope.",
  "color": {
    "dark": {
      "background": "#061A20",
      "aurora1": "#13A89E",
      "aurora2": "#1D4E89",
      "aurora3": "#C9803F",
      "accent": "#5EE6D0",
      "onAccent": "#052126",
      "lyo1": "#5EE6D0",
      "lyo2": "#F2A65A",
      "text": "#EAF5F3",
      "textSecondary": "rgba(234,245,243,0.66)",
      "track": "rgba(255,255,255,0.10)",
      "separator": "rgba(255,255,255,0.08)",
      "glassFill": "rgba(255,255,255,0.08)",
      "glassStroke": "rgba(255,255,255,0.14)",
      "glassHighlight": "rgba(255,255,255,0.18)",
      "glassShadow": "rgba(0,0,0,0.50)",
      "stateOk": "#4ADE9B",
      "stateWarn": "#F5C451",
      "stateBad": "#FF9E95"
    },
    "light": {
      "background": "#E6ECEF",
      "aurora1": "#8FE0C8",
      "aurora2": "#9CCBF2",
      "aurora3": "#F3CFA6",
      "accent": "#0A766D",
      "onAccent": "#FFFFFF",
      "lyo1": "#0A766D",
      "lyo2": "#E08A3C",
      "text": "#0F2329",
      "textSecondary": "rgba(15,35,41,0.62)",
      "track": "rgba(15,35,41,0.07)",
      "separator": "rgba(15,35,41,0.07)",
      "glassFill": "rgba(255,255,255,0.55)",
      "glassStroke": "rgba(255,255,255,0.80)",
      "glassHighlight": "rgba(255,255,255,0.95)",
      "glassShadow": "rgba(40,70,90,0.25)",
      "stateOk": "#0E7C4A",
      "stateWarn": "#946010",
      "stateBad": "#B83248"
    }
  },
  "glass": {
    "blur": 26,
    "blurRange": [24, 30],
    "saturation": 1.6,
    "strokeWidth": 1,
    "androidFallback": "solid translucent fill without blur on low-end devices"
  },
  "font": {
    "family": "Manrope",
    "fallback": ["SF Pro Text", "Roboto", "system-ui", "sans-serif"],
    "weights": [300, 400, 500, 600, 700, 800],
    "numeric": "tabular-nums"
  },
  "type": {
    "dailyNumber": { "size": 56, "weight": 600, "letterSpacing": -0.04, "lineHeight": 1.0 },
    "title":       { "size": 28, "weight": 700, "letterSpacing": -0.02, "lineHeight": 1.15 },
    "headline":    { "size": 19, "weight": 700, "letterSpacing": -0.02, "lineHeight": 1.25 },
    "amount":      { "size": 17, "weight": 600, "letterSpacing": 0,     "lineHeight": 1.3 },
    "body":        { "size": 15, "weight": 400, "letterSpacing": 0,     "lineHeight": 1.5 },
    "caption":     { "size": 12, "weight": 500, "letterSpacing": 0,     "lineHeight": 1.35 },
    "label":       { "size": 11, "weight": 700, "letterSpacing": 0.1,   "lineHeight": 1.3, "textTransform": "uppercase" }
  },
  "radius": { "hero": 26, "card": 20, "row": 9, "pill": 999 },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 }
}
